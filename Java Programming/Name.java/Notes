4/3.0 = 1.33333
117%7 = 5
(-1.3)/0 = -Infinity
4-3*5 = -11
0.3-0.2 = 0.099999999999999999999
0/1.3 = 0.0
4-(3*5) = -11
0.2 - 0.1 = 0.1
